# This GitHub repo is PUBLIC and only publishes the website (site/, hosted on Vercel).
# Everything else in this folder (videos, app, documents, design tools) stays local.
/*
!/.gitignore
!/.gitattributes
!/site/
!/vercel.json
!/api/
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/publish-blog.yml

# plain-text keys handed over by hand: never commit
env.txt

.vercel
.env*

# compiled Python caches: never commit (they differ per Python version and would look like site changes)
__pycache__/
*.pyc
